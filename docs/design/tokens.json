{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Surf Studio design tokens. Flat slate dark theme, medium contrast. Source of truth for surf-ui (GPUI) and the prototype in docs/design/prototype.html. Units: px at 1x scale.",

  "color": {
    "surface": {
      "void":     { "$type": "color", "$value": "#161a21", "$description": "Window background, Perform view background" },
      "chrome":   { "$type": "color", "$value": "#1f242d", "$description": "Control bar, pane headers, tabs, status bar, rulers" },
      "panel":    { "$type": "color", "$value": "#1b2029", "$description": "Inspector, editor bars, channel strips, local inspector" },
      "head":     { "$type": "color", "$value": "#21262f", "$description": "Track header rows" },
      "headSel":  { "$type": "color", "$value": "#2a3140", "$description": "Selected track header" },
      "lane":     { "$type": "color", "$value": "#191d25", "$description": "Tracks area / piano roll background" },
      "laneSel":  { "$type": "color", "$value": "#232a36", "$description": "Lane of the selected track" },
      "field":    { "$type": "color", "$value": "#15191f", "$description": "Inputs, LCD, slots, meter wells" },
      "hover":    { "$type": "color", "$value": "#262c37", "$description": "Hover fill for buttons, rows, menu items" },
      "raised":   { "$type": "color", "$value": "#2a303b", "$description": "Transport buttons, fader cap, knob body" },
      "stripSel": { "$type": "color", "$value": "#232935", "$description": "Selected channel strip" }
    },
    "line": {
      "default": { "$type": "color", "$value": "#2c323d", "$description": "Pane separators, 1px borders" },
      "strong":  { "$type": "color", "$value": "#3a414e", "$description": "Control outlines, segmented groups" },
      "row":     { "$type": "color", "$value": "#242a33", "$description": "Lane and table row dividers" }
    },
    "text": {
      "primary":   { "$type": "color", "$value": "#d3d8e0" },
      "secondary": { "$type": "color", "$value": "#99a1af" },
      "tertiary":  { "$type": "color", "$value": "#6d7584", "$description": "Labels, captions, inactive tabs" },
      "disabled":  { "$type": "color", "$value": "#4f5663", "$description": "Planned / disabled controls" }
    },
    "accent": {
      "fg":   { "$type": "color", "$value": "#6cb8d6", "$description": "Playhead, LCD digits, active state text, focus ring" },
      "bg":   { "$type": "color", "$value": "#24394a", "$description": "Fill behind an active control" },
      "line": { "$type": "color", "$value": "#3b5e73", "$description": "Border of an active control" }
    },
    "state": {
      "record": { "$type": "color", "$value": "#d9596a" },
      "play":   { "$type": "color", "$value": "#6cc596", "$description": "Play button on, OK dot, meter low band" },
      "warn":   { "$type": "color", "$value": "#d6b25e", "$description": "Meter mid band" },
      "solo":   { "$type": "color", "$value": "#d6b25e" },
      "mute":   { "$type": "color", "$value": "#7d9fd6" },
      "cycle":  { "$type": "color", "$value": "rgba(214,178,94,0.55)", "$description": "Cycle bar on; 0.14 alpha when off" }
    },
    "slot": {
      "instBuiltin": { "fg": { "$type": "color", "$value": "#6cc596" }, "bg": { "$type": "color", "$value": "rgba(108,197,150,0.10)" }, "line": { "$type": "color", "$value": "rgba(108,197,150,0.32)" } },
      "instPlugin":  { "fg": { "$type": "color", "$value": "#b3a9dc" }, "bg": { "$type": "color", "$value": "rgba(150,136,210,0.12)" }, "line": { "$type": "color", "$value": "rgba(150,136,210,0.35)" } },
      "fx":          { "$description": "Uses accent.fg / accent.bg / accent.line" }
    },
    "track": {
      "$description": "Assigned round-robin to new tracks. Regions use the track colour at 15% alpha (30% selected) with a 50% alpha border (100% selected).",
      "green":  { "$type": "color", "$value": "#5e9e78" },
      "blue":   { "$type": "color", "$value": "#5f8fc4" },
      "amber":  { "$type": "color", "$value": "#c49a5a" },
      "rose":   { "$type": "color", "$value": "#b46e8e" },
      "violet": { "$type": "color", "$value": "#8a7cc0" },
      "teal":   { "$type": "color", "$value": "#5aa8a2" },
      "brick":  { "$type": "color", "$value": "#c07462" }
    },
    "velocity": {
      "$description": "Piano roll note colour, interpolated linearly across velocity 1..127 (Logic convention).",
      "stops": { "$type": "color", "$value": ["#8a76c8", "#5f8fd0", "#5cad8a", "#b5b45e", "#cf9356", "#c96a5e"] }
    },
    "grid": {
      "bar":     { "$type": "color", "$value": "rgba(170,185,210,0.17)" },
      "beat":    { "$type": "color", "$value": "rgba(170,185,210,0.10)" },
      "sub":     { "$type": "color", "$value": "rgba(150,175,225,0.04)" },
      "octave":  { "$type": "color", "$value": "rgba(170,185,210,0.12)", "$description": "Piano roll row line at every C" },
      "outside": { "$type": "color", "$value": "rgba(0,0,0,0.22)", "$description": "Shade beyond region end / project end" },
      "marquee": { "$type": "color", "$value": "rgba(108,184,214,0.10)", "$description": "Fill; border is rgba(108,184,214,0.70)" }
    },
    "keys": {
      "white":       { "$type": "color", "$value": "#b6bcc6" },
      "black":       { "$type": "color", "$value": "#262b34" },
      "whiteActive": { "$type": "color", "$value": "#6cb8d6" },
      "blackActive": { "$type": "color", "$value": "#4f8ea8" }
    }
  },

  "font": {
    "family": {
      "ui":    { "$type": "fontFamily", "$value": ["IBM Plex Sans", "-apple-system", "system-ui", "sans-serif"] },
      "label": { "$type": "fontFamily", "$value": ["Barlow Condensed", "IBM Plex Sans", "sans-serif"], "$description": "Uppercase section labels, tabs, M/S/R" },
      "mono":  { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "Menlo", "monospace"], "$description": "LCD, positions, dB, note names" }
    },
    "size": {
      "caption": { "$type": "dimension", "$value": "9px",    "$description": "Strip slot labels" },
      "label":   { "$type": "dimension", "$value": "10px",   "$description": "Uppercase labels (letter-spacing 0.09em)" },
      "small":   { "$type": "dimension", "$value": "11px" },
      "body":    { "$type": "dimension", "$value": "11.5px", "$description": "Default UI text" },
      "title":   { "$type": "dimension", "$value": "12.5px", "$description": "Pane titles (label family, uppercase)" },
      "lcd":     { "$type": "dimension", "$value": "15px" },
      "lcdSmall":{ "$type": "dimension", "$value": "12.5px" }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "letterSpacing": { "label": "0.09em", "tab": "0.08em", "title": "0.10em" }
  },

  "radius": {
    "xs": { "$type": "dimension", "$value": "2px", "$description": "Notes, meters" },
    "sm": { "$type": "dimension", "$value": "4px", "$description": "Fields, slots, M/S/R, regions" },
    "md": { "$type": "dimension", "$value": "6px", "$description": "Buttons, segmented groups" },
    "lg": { "$type": "dimension", "$value": "7px", "$description": "LCD, menus" }
  },

  "space": {
    "1": { "$type": "dimension", "$value": "2px" },
    "2": { "$type": "dimension", "$value": "4px" },
    "3": { "$type": "dimension", "$value": "6px" },
    "4": { "$type": "dimension", "$value": "8px" },
    "5": { "$type": "dimension", "$value": "10px" },
    "6": { "$type": "dimension", "$value": "12px" }
  },

  "border": { "width": { "$type": "dimension", "$value": "1px" }, "selectedRegion": { "$type": "dimension", "$value": "1.5px" } },

  "elevation": {
    "$description": "Flat UI: only floating menus cast a shadow.",
    "menu": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "10px", "blur": "26px", "spread": "0px", "color": "rgba(0,0,0,0.35)" } }
  },

  "motion": {
    "fast":   { "$type": "duration", "$value": "80ms",  "$description": "Meters, MIDI activity" },
    "normal": { "$type": "duration", "$value": "120ms", "$description": "Disclosure rotation, toggles" },
    "$description": "No other animation. Respect reduced-motion: disable all transitions."
  },

  "layout": {
    "controlBar":   { "height": "48px", "paddingX": "10px", "gap": "10px" },
    "toolbar":      { "height": "32px" },
    "paneHeader":   { "height": "30px" },
    "statusBar":    { "height": "24px" },
    "iconButton":   { "size": "28px", "icon": "14px" },
    "lcd":          { "height": "36px", "cellPaddingX": "12px" },
    "library":      { "width": "220px" },
    "inspector":    { "width": "236px", "sectionHeader": "28px", "labelColumn": "72px" },
    "trackHeader":  { "width": "236px", "columns": "20px 26px 1fr auto" },
    "lane":         { "height": "54px" },
    "ruler":        { "tracks": "34px", "editor": "26px", "cycleBand": "3px..12px" },
    "splitter":     { "size": "5px" },
    "editor":       { "defaultHeight": "300px", "minHeight": "140px", "tabs": "30px", "bar": "32px", "localInspector": "156px" },
    "pianoRoll":    { "keysWidth": "64px", "rowHeight": "12px", "velocityLane": "70px", "beatWidth": { "default": "90px", "min": "20px", "max": "260px" } },
    "tracksArea":   { "beatWidth": { "default": "11px", "min": "3px", "max": "90px" } },
    "channelStrip": { "width": "80px", "slot": "18px", "knob": "24px", "faderCap": "24x30px", "faderTrack": "4px", "meter": "7px", "nameBar": "22px" },
    "msrButton":    { "width": "20px", "height": "17px", "inHeader": "18x16px" }
  }
}
